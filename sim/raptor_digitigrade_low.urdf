      <update_rate>5</update_rate>
      <topic>/raptor/camera</topic>
      <camera>
        <horizontal_fov>1.05</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.05</near>
            <far>20</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
