    <!-- Claw is visual only; sharp terrain anchoring is not simulated. -->
    <visual>
      <origin rpy="0 0.3 0" xyz="0.08499999999999999 0 -0.004"/>
      <geometry>
        <box size="0.026 0.012 0.013"/>
      </geometry>
      <material name="toe_claw">
        <color rgba="0.12 0.14 0.16 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0375 0 0"/>
      <geometry>
        <box size="0.075 0.026 0.034"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0375 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="7.633333333333334e-06" ixy="0" ixz="0" iyy="2.8254166666666668e-05" iyz="0" izz="2.6254166666666667e-05"/>
    </inertial>
  </link>
  <joint name="right_toe_3_distal_joint" type="revolute">
    <parent link="right_toe_3_proximal_link"/>
    <child link="right_toe_3_distal_link"/>
    <origin rpy="0 0 0" xyz="0.070 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" lower="-0.55" upper="0.65" velocity="4"/>
    <dynamics damping="0.08" friction="0.005"/>
  </joint>
  <gazebo reference="right_toe_3_distal_joint">
    <springReference>0</springReference>
    <springStiffness>8.0</springStiffness>
  </gazebo>
  <gazebo reference="right_toe_3_distal_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <sensor name="right_toe_3_distal_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <contact>
        <collision>right_toe_3_distal_link_collision</collision>
        <topic>/raptor/right/toe_3_distal/contact</topic>
      </contact>
    </sensor>
  </gazebo>
  <joint name="right_ankle_pitch_joint" type="revolute">
    <parent link="right_shin_link"/>
    <child link="right_foot_link"/>
    <origin rpy="0 0 0" xyz="0 0 -0.3"/>
    <axis xyz="0 1 0"/>
    <limit effort="80" lower="-0.95" upper="0.95" velocity="2.5"/>
  </joint>
  <!-- ===================================================== -->
  <!-- TAIL : 2 DOF                                         -->
  <!-- Tail Yaw + Tail Pitch                                 -->
  <!-- ===================================================== -->
  <!-- 9. TAIL YAW LINK -->
  <!-- 몸통 뒤쪽에서 좌우로 회전하는 꼬리 베이스 -->
  <link name="tail_yaw_link">
    <visual>
      <!-- 관절 기준 뒤쪽(-X)으로 꼬리 베이스가 뻗음 -->
      <origin rpy="0 0 0" xyz="-0.08 0 0"/>
      <geometry>
        <box size="0.16 0.09 0.09"/>
      </geometry>
      <material name="tail_dark">
        <color rgba="0.18 0.19 0.21 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.08 0 0"/>
      <geometry>
        <box size="0.16 0.09 0.09"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.08 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0007" ixy="0.0" ixz="0.0" iyy="0.0014" iyz="0.0" izz="0.0014"/>
    </inertial>
  </link>
  <joint name="tail_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="tail_yaw_link"/>
    <!-- 몸통 뒤쪽 끝에 꼬리 장착 -->
    <origin rpy="0 0 0" xyz="-0.30 0 0"/>
    <!-- Z축 회전 = 좌우 움직임 -->
    <axis xyz="0 0 1"/>
    <!-- 약 좌우 ±46도 -->
    <limit effort="50" lower="-0.80" upper="0.80" velocity="2.0"/>
  </joint>
  <!-- 10. TAIL PITCH + MAIN TAIL -->
  <!-- 꼬리를 위아래로 움직이는 관절 -->
  <link name="tail_link">
    <visual>
      <!-- Pitch 관절에서 뒤쪽으로 0.5m 뻗는 꼬리 -->
      <origin rpy="0 0 0" xyz="-0.475 0 0"/>
      <geometry>
        <box size="0.95 0.065 0.065"/>
      </geometry>
      <material name="tail_gray">
        <color rgba="0.35 0.37 0.40 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.475 0 0"/>
      <geometry>
        <box size="0.95 0.065 0.065"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.475 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0005633333333333334" ixy="0.0" ixz="0.0" iyy="0.06044833333333333" iyz="0.0" izz="0.06044833333333333"/>
    </inertial>
  </link>
  <joint name="tail_pitch_joint" type="revolute">
    <parent link="tail_yaw_link"/>
    <child link="tail_link"/>
    <!-- 꼬리 베이스 끝 -->
    <origin rpy="0 0 0" xyz="-0.16 0 0"/>
    <!-- Y축 회전 = 위 / 아래 -->
    <axis xyz="0 1 0"/>
    <!-- 약 ±34도 -->
    <limit effort="50" lower="-0.60" upper="0.60" velocity="2.0"/>
  </joint>
  <!-- ===================================================== -->
  <!-- ROS 2 CONTROL : 10 DOF                                -->
  <!-- ===================================================== -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- LEFT LEG -->
    <joint name="left_hip_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="left_hip_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="left_knee_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="left_ankle_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- RIGHT LEG -->
    <joint name="right_hip_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_hip_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_knee_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_ankle_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- TAIL -->
    <joint name="tail_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="tail_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <!-- Gazebo ↔ ros2_control bridge -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>
        /tmp/pfx/share/raptor_control/config/controllers.yaml
      </parameters>
      <!-- controller가 아직 안 잡은 관절도 현재 위치 유지 -->
      <hold_joints>true</hold_joints>
      <!-- position control 반응 강도 -->
      <position_proportional_gain>0.3</position_proportional_gain>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/raptor/passive_joint_states</topic>
      <update_rate>50</update_rate>
      <joint_name>left_toe_1_proximal_joint</joint_name>
      <joint_name>left_toe_1_distal_joint</joint_name>
      <joint_name>left_toe_2_proximal_joint</joint_name>
      <joint_name>left_toe_2_distal_joint</joint_name>
      <joint_name>left_toe_3_proximal_joint</joint_name>
      <joint_name>left_toe_3_distal_joint</joint_name>
      <joint_name>right_toe_1_proximal_joint</joint_name>
      <joint_name>right_toe_1_distal_joint</joint_name>
      <joint_name>right_toe_2_proximal_joint</joint_name>
      <joint_name>right_toe_2_distal_joint</joint_name>
      <joint_name>right_toe_3_proximal_joint</joint_name>
      <joint_name>right_toe_3_distal_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
