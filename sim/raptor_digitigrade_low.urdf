        <topic>/raptor/left/toe_3_distal/contact</topic>
      </contact>
    </sensor>
  </gazebo>
  <joint name="left_ankle_pitch_joint" type="revolute">
    <parent link="left_shin_link"/>
    <child link="left_foot_link"/>
    <!-- 종아리 끝부분에 발목 배치 -->
    <origin rpy="0 0 0" xyz="0 0 -0.3"/>
    <!-- Y축 회전 = 발 앞뒤 기울임 -->
    <axis xyz="0 1 0"/>
    <!-- 약 -40도 ~ +40도 -->
    <limit effort="80" lower="-0.95" upper="0.95" velocity="2.5"/>
  </joint>
  <!-- ===================================================== -->
  <!-- RIGHT LEG : 4 DOF                                     -->
  <!-- Hip Roll + Hip Pitch + Knee Pitch + Ankle Pitch       -->
  <!-- ===================================================== -->
  <!-- 1. RIGHT HIP ROLL LINK -->
  <link name="right_hip_roll_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.06"/>
      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>
      <material name="right_joint_dark">
        <color rgba="0.15 0.16 0.18 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.06"/>
      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.06"/>
      <mass value="0.8"/>
      <inertia ixx="0.0016" ixy="0.0" ixz="0.0" iyy="0.0016" iyz="0.0" izz="0.0013"/>
    </inertial>
  </link>
  <joint name="right_hip_roll_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_hip_roll_link"/>
    <!-- 오른쪽은 Y 음수 방향 -->
    <origin rpy="0 0 0" xyz="0 -0.18 -0.05"/>
    <!--
      오른쪽은 왼쪽과 반대 방향의 X축을 사용.
      따라서 양쪽에서 +값을 줬을 때 다리가 바깥으로 벌어지게 함.
    -->
    <axis xyz="-1 0 0"/>
    <limit effort="80" lower="-0.50" upper="0.50" velocity="2.0"/>
  </joint>
  <!-- 2. RIGHT HIP PITCH + THIGH -->
  <link name="right_thigh_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.13"/>
      <geometry>
        <box size="0.10 0.10 0.26"/>
      </geometry>
      <material name="right_leg_gray">
        <color rgba="0.55 0.57 0.60 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.13"/>
      <geometry>
        <box size="0.10 0.10 0.26"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.13"/>
      <mass value="1.5"/>
      <inertia ixx="0.0097" ixy="0.0" ixz="0.0" iyy="0.0097" iyz="0.0" izz="0.0025"/>
    </inertial>
  </link>
  <joint name="right_hip_pitch_joint" type="revolute">
    <parent link="right_hip_roll_link"/>
    <child link="right_thigh_link"/>
    <origin rpy="0 0 0" xyz="0 0 -0.06"/>
    <!-- 앞 / 뒤 -->
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-1.20" upper="0.80" velocity="2.5"/>
  </joint>
  <!-- 3. RIGHT KNEE PITCH + SHIN -->
  <link name="right_shin_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.085 0.085 0.3"/>
      </geometry>
      <material name="right_shin_gray">
        <color rgba="0.42 0.44 0.47 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.085 0.085 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.15"/>
      <mass value="1.1"/>
      <inertia ixx="0.008912291666666667" ixy="0.0" ixz="0.0" iyy="0.008912291666666667" iyz="0.0" izz="0.0013"/>
    </inertial>
  </link>
  <joint name="right_knee_pitch_joint" type="revolute">
    <parent link="right_thigh_link"/>
    <child link="right_shin_link"/>
    <origin rpy="0 0 0" xyz="0 0 -0.26"/>
    <axis xyz="0 1 0"/>
    <limit effort="120" lower="0.0" upper="2.20" velocity="3.0"/>
  </joint>
  <!-- 4. RIGHT ANKLE PITCH + FOOT -->
  <link name="right_foot_link">
    <visual>
      <origin xyz="0.04229547378930832 0 -0.2329494510833709"/>
      <geometry>
        <box size="0.15 0.1 0.035"/>
      </geometry>
      <material name="foot_pad_dark">
        <color rgba="0.08 0.09 0.10 1"/>
      </material>
    </visual>
    <visual>
      <origin rpy="0 -0.35 0" xyz="0.04114773689465416 0 -0.11272472554168546"/>
      <geometry>
        <box size="0.06 0.06 0.24"/>
      </geometry>
      <material name="metatarsus_gray">
        <color rgba="0.42 0.44 0.47 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.04229547378930832 0 -0.2329494510833709"/>
      <geometry>
        <box size="0.15 0.1 0.035"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 -0.35 0" xyz="0.04114773689465416 0 -0.11272472554168546"/>
      <geometry>
        <box size="0.06 0.06 0.24"/>
      </geometry>
    </collision>
    <!-- Lumped inertia: half the mass in the metatarsus, half in the pad, about their midpoint. -->
    <inertial>
      <origin xyz="0.041721605341981244 0 -0.17283708831252817"/>
      <mass value="0.3"/>
      <inertia ixx="0.0015206863748448314" ixy="0" ixz="0" iyy="0.0018331863748448313" iyz="0" izz="0.0008125"/>
    </inertial>
  </link>
