<?xml version="1.0"?>

<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="raptor">

  <!-- Bench fixture is explicitly opt-in and never a standing validation. -->
  <xacro:arg name="test_fixture" default="false"/>
  <xacro:arg name="detailed_visuals" default="false"/>
  <xacro:arg name="sensors" default="false"/>
  <xacro:arg name="passive_toes" default="false"/>
  <xacro:arg name="toe_stiffness_scale" default="1.0"/>
  <xacro:property name="toe_stiffness_scale" value="$(arg toe_stiffness_scale)"/>
  <xacro:arg name="crouched_start" default="false"/>
  <xacro:arg name="crouch_hip_pitch" default="-0.15"/>
  <xacro:property name="crouch_hip" value="$(arg crouch_hip_pitch)"/>
  <!-- Leg proportions (m). Link inertias below are still literal values for these lengths. -->
  <!-- legacy: original straight leg and flat foot (reproduces evidence 01-62).
       digitigrade: shorter thigh + inclined metatarsus foot, still 10 active DOF. -->
  <xacro:arg name="leg_design" default="legacy"/>
  <!-- Unknown values fail with a KeyError instead of silently picking a design. -->
  <xacro:property name="legacy" value="${dict(legacy=True, digitigrade=False)['$(arg leg_design)']}"/>
  <xacro:property name="hip_drop" value="0.12"/>
  <xacro:property name="thigh_length" value="${0.32 if legacy else 0.26}"/>
  <xacro:property name="shin_length" value="0.30"/>
  <!-- Legacy inertias are the original literals; digitigrade uses the box formula. -->
  <xacro:property name="thigh_ixx" value="${0.0140 if legacy else 1.5*(0.10**2+thigh_length**2)/12}"/>
  <xacro:property name="shin_ixx" value="${0.0089 if legacy else 1.1*(0.085**2+shin_length**2)/12}"/>
  <!-- Legacy thigh/shin meshes fit only the legacy lengths. -->
  <xacro:property name="leg_meshes" value="${'$(arg detailed_visuals)' == 'true' and legacy}"/>
  <xacro:include filename="passive_toes.xacro"/>
  <xacro:include filename="digitigrade_foot.xacro"/>
  <!-- crouched_start knee; the ankle keeps the sole level (hip + knee + ankle = 0). -->
  <xacro:property name="crouch_knee" value="${0.4 if legacy else 0.5}"/>
  <xacro:if value="$(arg sensors)">
    <gazebo reference="base_link">
      <sensor name="body_imu" type="imu">
        <always_on>true</always_on><update_rate>50</update_rate>
        <topic>/raptor/imu</topic>
        <imu><orientation_reference_frame><localization>ENU</localization></orientation_reference_frame></imu>
      </sensor>
      <sensor name="front_rgbd" type="rgbd_camera">
        <pose>0.42 0 0.04 0 0 0</pose>
        <always_on>true</always_on><update_rate>5</update_rate>
        <topic>/raptor/camera</topic>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>20</far></clip>
          <depth_camera><clip><near>0.05</near><far>20</far></clip></depth_camera>
        </camera>
      </sensor>
    </gazebo>
    <xacro:macro name="foot_contact" params="side">
      <gazebo reference="${side}_foot_link">
        <sensor name="${side}_foot_contact" type="contact">
          <always_on>true</always_on><update_rate>50</update_rate>
          <topic>/raptor/${side}_foot/contact</topic>
          <contact>
            <collision>${side}_foot_link_collision</collision>
            <topic>/raptor/${side}_foot/contact</topic>
          </contact>
        </sensor>
      </gazebo>
    </xacro:macro>
    <xacro:foot_contact side="left"/><xacro:foot_contact side="right"/>
  </xacro:if>
  <xacro:if value="$(arg test_fixture)">
    <link name="world"/>
    <joint name="test_fixture_joint" type="fixed">
      <parent link="world"/><child link="base_root"/>
      <origin xyz="0 0 0.25"/>
    </joint>
  </xacro:if>

    <!-- Dummy root link for KDL -->
  <link name="base_root"/>

  <joint name="base_root_joint" type="fixed">
    <parent link="base_root"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.85" rpy="0 0 0"/>
  </joint>

  <!--
    Raptor prototype
    Step 1: body only
  -->

  <link name="base_link">

    <!-- 화면에 보이는 외형 -->
    <xacro:unless value="$(arg detailed_visuals)"><visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.60 0.28 0.22"/>
      </geometry>

      <material name="body_gray">
        <color rgba="0.35 0.37 0.40 1.0"/>
      </material>
    </visual></xacro:unless>
    <xacro:if value="$(arg detailed_visuals)">
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/base_link__graphite.dae"/></geometry><material name="raptor_graphite"><color rgba="0.065 0.075 0.085 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/base_link__titanium.dae"/></geometry><material name="raptor_titanium"><color rgba="0.36 0.4 0.43 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/base_link__ivory.dae"/></geometry><material name="raptor_ivory"><color rgba="0.72 0.72 0.65 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/base_link__copper.dae"/></geometry><material name="raptor_copper"><color rgba="0.66 0.29 0.08 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/base_link__rubber.dae"/></geometry><material name="raptor_rubber"><color rgba="0.025 0.028 0.032 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/base_link__lens.dae"/></geometry><material name="raptor_lens"><color rgba="0.05 0.26 0.33 1"/></material></visual>
    </xacro:if>

    <!-- Gazebo가 충돌 계산할 때 사용하는 모양 -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.60 0.28 0.22"/>
      </geometry>
    </collision>

    <!-- 무게와 회전 특성 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="8.0"/>

      <inertia
        ixx="0.0843"
        ixy="0.0"
        ixz="0.0"
        iyy="0.2691"
        iyz="0.0"
        izz="0.2923"/>
    </inertial>

    </link>
    <!-- ========================================= -->
    <!-- LEFT HIP ROLL -->
    <!-- 다리를 좌우로 벌리고 모으는 첫 번째 관절 -->
    <!-- ========================================= -->

    <link name="left_hip_roll_link">

    <xacro:unless value="$(arg detailed_visuals)"><visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>

      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>

      <material name="joint_dark">
        <color rgba="0.15 0.16 0.18 1.0"/>
      </material>
    </visual></xacro:unless>
    <xacro:if value="$(arg detailed_visuals)">
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_hip_roll_link__graphite.dae"/></geometry><material name="raptor_graphite"><color rgba="0.065 0.075 0.085 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_hip_roll_link__titanium.dae"/></geometry><material name="raptor_titanium"><color rgba="0.36 0.4 0.43 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_hip_roll_link__ivory.dae"/></geometry><material name="raptor_ivory"><color rgba="0.72 0.72 0.65 1"/></material></visual>
    </xacro:if>

    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>

      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>

      <mass value="0.8"/>

      <inertia
        ixx="0.0016"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0016"
        iyz="0.0"
        izz="0.0013"/>
    </inertial>

  </link>


  <joint name="left_hip_roll_joint" type="revolute">

    <parent link="base_link"/>
    <child link="left_hip_roll_link"/>

    <!-- 몸통 왼쪽 아래에 관절 배치 -->
    <origin xyz="0 0.18 -0.05" rpy="0 0 0"/>

    <!-- X축 회전 = Hip Roll -->
    <axis xyz="1 0 0"/>

    <!-- 약 -29도 ~ +29도 -->
    <limit
      lower="-0.50"
      upper="0.50"
      effort="80"
      velocity="2.0"/>

  </joint> 
    <!-- ========================================= -->
  <!-- LEFT HIP PITCH + THIGH -->
  <!-- 다리를 앞뒤로 움직이는 두 번째 관절 -->
  <!-- ========================================= -->

  <link name="left_thigh_link">

    <xacro:unless value="${leg_meshes}"><visual>
      <!-- 관절에서 아래쪽으로 허벅지가 내려감 -->
      <origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>

      <geometry>
        <box size="0.10 0.10 ${thigh_length}"/>
      </geometry>

      <material name="leg_gray">
        <color rgba="0.55 0.57 0.60 1.0"/>
      </material>
    </visual></xacro:unless>
    <xacro:if value="${leg_meshes}">
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_thigh_link__graphite.dae"/></geometry><material name="raptor_graphite"><color rgba="0.065 0.075 0.085 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_thigh_link__titanium.dae"/></geometry><material name="raptor_titanium"><color rgba="0.36 0.4 0.43 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_thigh_link__ivory.dae"/></geometry><material name="raptor_ivory"><color rgba="0.72 0.72 0.65 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_thigh_link__copper.dae"/></geometry><material name="raptor_copper"><color rgba="0.66 0.29 0.08 1"/></material></visual>
    </xacro:if>

    <collision>
      <origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>

      <geometry>
        <box size="0.10 0.10 ${thigh_length}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>

      <mass value="1.5"/>

      <inertia
        ixx="${thigh_ixx}"
        ixy="0.0"
        ixz="0.0"
        iyy="${thigh_ixx}"
        iyz="0.0"
        izz="0.0025"/>
    </inertial>

  </link>


  <joint name="left_hip_pitch_joint" type="revolute">

    <parent link="left_hip_roll_link"/>
    <child link="left_thigh_link"/>

    <!-- Hip Roll 블록 아래쪽에 Hip Pitch 배치 -->
    <origin xyz="0 0 ${-hip_drop}" rpy="0 0 0"/>

    <!-- Y축 회전 = 다리 앞뒤 움직임 -->
    <axis xyz="0 1 0"/>

    <!-- 약 -69도 ~ +46도 -->
    <limit
      lower="-1.20"
      upper="0.80"
      effort="100"
      velocity="2.5"/>

  </joint>
    <!-- ========================================= -->
  <!-- LEFT KNEE PITCH + SHIN -->
  <!-- 무릎을 굽히고 펴는 세 번째 관절 -->
  <!-- ========================================= -->

  <link name="left_shin_link">

    <xacro:unless value="${leg_meshes}"><visual>
      <!-- 무릎 아래로 종아리가 내려감 -->
      <origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>

      <geometry>
        <box size="0.085 0.085 ${shin_length}"/>
      </geometry>

      <material name="shin_gray">
        <color rgba="0.42 0.44 0.47 1.0"/>
      </material>
    </visual></xacro:unless>
    <xacro:if value="${leg_meshes}">
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_shin_link__graphite.dae"/></geometry><material name="raptor_graphite"><color rgba="0.065 0.075 0.085 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_shin_link__titanium.dae"/></geometry><material name="raptor_titanium"><color rgba="0.36 0.4 0.43 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_shin_link__ivory.dae"/></geometry><material name="raptor_ivory"><color rgba="0.72 0.72 0.65 1"/></material></visual>
    </xacro:if>

    <collision>
      <origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>

      <geometry>
        <box size="0.085 0.085 ${shin_length}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>

      <mass value="1.1"/>

      <inertia
        ixx="${shin_ixx}"
        ixy="0.0"
        ixz="0.0"
        iyy="${shin_ixx}"
        iyz="0.0"
        izz="0.0013"/>
    </inertial>

  </link>


  <joint name="left_knee_pitch_joint" type="revolute">

    <parent link="left_thigh_link"/>
    <child link="left_shin_link"/>

    <!-- 허벅지 끝 = 무릎 위치 -->
    <origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/>

    <!-- Y축 회전 = 무릎 굽힘 -->
    <axis xyz="0 1 0"/>

    <!--
      0 rad = 다리를 편 상태
      약 126도까지 굽힘 허용
    -->
    <limit
      lower="0.0"
      upper="2.20"
      effort="120"
      velocity="3.0"/>

  </joint>
    <!-- ========================================= -->
  <!-- LEFT ANKLE PITCH + FOOT -->
  <!-- 발목을 앞뒤로 움직이는 네 번째 관절 -->
  <!-- ========================================= -->

  <xacro:if value="${legacy}">
  <xacro:unless value="$(arg passive_toes)">
  <link name="left_foot_link">

    <xacro:unless value="$(arg detailed_visuals)"><visual>
      <!-- 발목 기준으로 발을 약간 앞으로 배치 -->
      <origin xyz="0.06 0 -0.03" rpy="0 0 0"/>

      <geometry>
        <box size="0.24 0.12 0.06"/>
      </geometry>

      <material name="foot_dark">
        <color rgba="0.12 0.13 0.15 1.0"/>
      </material>
    </visual></xacro:unless>
    <xacro:if value="$(arg detailed_visuals)">
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_foot_link__graphite.dae"/></geometry><material name="raptor_graphite"><color rgba="0.065 0.075 0.085 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_foot_link__titanium.dae"/></geometry><material name="raptor_titanium"><color rgba="0.36 0.4 0.43 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_foot_link__ivory.dae"/></geometry><material name="raptor_ivory"><color rgba="0.72 0.72 0.65 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/left_foot_link__rubber.dae"/></geometry><material name="raptor_rubber"><color rgba="0.025 0.028 0.032 1"/></material></visual>
    </xacro:if>

    <collision>
      <origin xyz="0.06 0 -0.03" rpy="0 0 0"/>

      <geometry>
        <box size="0.24 0.12 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.06 0 -0.03" rpy="0 0 0"/>

      <mass value="0.6"/>

      <inertia
        ixx="0.0009"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0031"
        iyz="0.0"
        izz="0.0036"/>
    </inertial>

  </link>
  </xacro:unless>
  <xacro:if value="$(arg passive_toes)"><xacro:passive_foot side="left"/></xacro:if>
  </xacro:if>
  <xacro:unless value="${legacy}"><xacro:digitigrade_foot side="left" passive="$(arg passive_toes)"/></xacro:unless>


  <joint name="left_ankle_pitch_joint" type="revolute">

    <parent link="left_shin_link"/>
    <child link="left_foot_link"/>

    <!-- 종아리 끝부분에 발목 배치 -->
    <origin xyz="0 0 ${-shin_length}" rpy="0 0 0"/>

    <!-- Y축 회전 = 발 앞뒤 기울임 -->
    <axis xyz="0 1 0"/>

    <!-- 약 -40도 ~ +40도 -->
    <limit
      lower="-0.70"
      upper="0.70"
      effort="80"
      velocity="2.5"/>

  </joint>
    <!-- ===================================================== -->
  <!-- RIGHT LEG : 4 DOF                                     -->
  <!-- Hip Roll + Hip Pitch + Knee Pitch + Ankle Pitch       -->
  <!-- ===================================================== -->


  <!-- 1. RIGHT HIP ROLL LINK -->

  <link name="right_hip_roll_link">

    <xacro:unless value="$(arg detailed_visuals)"><visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>

      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>

      <material name="right_joint_dark">
        <color rgba="0.15 0.16 0.18 1.0"/>
      </material>
    </visual></xacro:unless>
    <xacro:if value="$(arg detailed_visuals)">
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_hip_roll_link__graphite.dae"/></geometry><material name="raptor_graphite"><color rgba="0.065 0.075 0.085 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_hip_roll_link__titanium.dae"/></geometry><material name="raptor_titanium"><color rgba="0.36 0.4 0.43 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_hip_roll_link__ivory.dae"/></geometry><material name="raptor_ivory"><color rgba="0.72 0.72 0.65 1"/></material></visual>
    </xacro:if>

    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>

      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>

      <mass value="0.8"/>

      <inertia
        ixx="0.0016"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0016"
        iyz="0.0"
        izz="0.0013"/>
    </inertial>

  </link>


  <joint name="right_hip_roll_joint" type="revolute">

    <parent link="base_link"/>
    <child link="right_hip_roll_link"/>

    <!-- 오른쪽은 Y 음수 방향 -->
    <origin xyz="0 -0.18 -0.05" rpy="0 0 0"/>

    <!--
      오른쪽은 왼쪽과 반대 방향의 X축을 사용.
      따라서 양쪽에서 +값을 줬을 때 다리가 바깥으로 벌어지게 함.
    -->
    <axis xyz="-1 0 0"/>

    <limit
      lower="-0.50"
      upper="0.50"
      effort="80"
      velocity="2.0"/>

  </joint>


  <!-- 2. RIGHT HIP PITCH + THIGH -->

  <link name="right_thigh_link">

    <xacro:unless value="${leg_meshes}"><visual>
      <origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>

      <geometry>
        <box size="0.10 0.10 ${thigh_length}"/>
      </geometry>

      <material name="right_leg_gray">
        <color rgba="0.55 0.57 0.60 1.0"/>
      </material>
    </visual></xacro:unless>
    <xacro:if value="${leg_meshes}">
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_thigh_link__graphite.dae"/></geometry><material name="raptor_graphite"><color rgba="0.065 0.075 0.085 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_thigh_link__titanium.dae"/></geometry><material name="raptor_titanium"><color rgba="0.36 0.4 0.43 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_thigh_link__ivory.dae"/></geometry><material name="raptor_ivory"><color rgba="0.72 0.72 0.65 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_thigh_link__copper.dae"/></geometry><material name="raptor_copper"><color rgba="0.66 0.29 0.08 1"/></material></visual>
    </xacro:if>

    <collision>
      <origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>

      <geometry>
        <box size="0.10 0.10 ${thigh_length}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>

      <mass value="1.5"/>

      <inertia
        ixx="${thigh_ixx}"
        ixy="0.0"
        ixz="0.0"
        iyy="${thigh_ixx}"
        iyz="0.0"
        izz="0.0025"/>
    </inertial>

  </link>


  <joint name="right_hip_pitch_joint" type="revolute">

    <parent link="right_hip_roll_link"/>
    <child link="right_thigh_link"/>

    <origin xyz="0 0 ${-hip_drop}" rpy="0 0 0"/>

    <!-- 앞 / 뒤 -->
    <axis xyz="0 1 0"/>

    <limit
      lower="-1.20"
      upper="0.80"
      effort="100"
      velocity="2.5"/>

  </joint>


  <!-- 3. RIGHT KNEE PITCH + SHIN -->

  <link name="right_shin_link">

    <xacro:unless value="${leg_meshes}"><visual>
      <origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>

      <geometry>
        <box size="0.085 0.085 ${shin_length}"/>
      </geometry>

      <material name="right_shin_gray">
        <color rgba="0.42 0.44 0.47 1.0"/>
      </material>
    </visual></xacro:unless>
    <xacro:if value="${leg_meshes}">
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_shin_link__graphite.dae"/></geometry><material name="raptor_graphite"><color rgba="0.065 0.075 0.085 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_shin_link__titanium.dae"/></geometry><material name="raptor_titanium"><color rgba="0.36 0.4 0.43 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_shin_link__ivory.dae"/></geometry><material name="raptor_ivory"><color rgba="0.72 0.72 0.65 1"/></material></visual>
    </xacro:if>

    <collision>
      <origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>

      <geometry>
        <box size="0.085 0.085 ${shin_length}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>

      <mass value="1.1"/>

      <inertia
        ixx="${shin_ixx}"
        ixy="0.0"
        ixz="0.0"
        iyy="${shin_ixx}"
        iyz="0.0"
        izz="0.0013"/>
    </inertial>

  </link>


  <joint name="right_knee_pitch_joint" type="revolute">

    <parent link="right_thigh_link"/>
    <child link="right_shin_link"/>

    <origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="0.0"
      upper="2.20"
      effort="120"
      velocity="3.0"/>

  </joint>


  <!-- 4. RIGHT ANKLE PITCH + FOOT -->

  <xacro:if value="${legacy}">
  <xacro:unless value="$(arg passive_toes)">
  <link name="right_foot_link">

    <xacro:unless value="$(arg detailed_visuals)"><visual>
      <origin xyz="0.06 0 -0.03" rpy="0 0 0"/>

      <geometry>
        <box size="0.24 0.12 0.06"/>
      </geometry>

      <material name="right_foot_dark">
        <color rgba="0.12 0.13 0.15 1.0"/>
      </material>
    </visual></xacro:unless>
    <xacro:if value="$(arg detailed_visuals)">
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_foot_link__graphite.dae"/></geometry><material name="raptor_graphite"><color rgba="0.065 0.075 0.085 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_foot_link__titanium.dae"/></geometry><material name="raptor_titanium"><color rgba="0.36 0.4 0.43 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_foot_link__ivory.dae"/></geometry><material name="raptor_ivory"><color rgba="0.72 0.72 0.65 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/right_foot_link__rubber.dae"/></geometry><material name="raptor_rubber"><color rgba="0.025 0.028 0.032 1"/></material></visual>
    </xacro:if>

    <collision>
      <origin xyz="0.06 0 -0.03" rpy="0 0 0"/>

      <geometry>
        <box size="0.24 0.12 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.06 0 -0.03" rpy="0 0 0"/>

      <mass value="0.6"/>

      <inertia
        ixx="0.0009"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0031"
        iyz="0.0"
        izz="0.0036"/>
    </inertial>

  </link>
  </xacro:unless>
  <xacro:if value="$(arg passive_toes)"><xacro:passive_foot side="right"/></xacro:if>
  </xacro:if>
  <xacro:unless value="${legacy}"><xacro:digitigrade_foot side="right" passive="$(arg passive_toes)"/></xacro:unless>


  <joint name="right_ankle_pitch_joint" type="revolute">

    <parent link="right_shin_link"/>
    <child link="right_foot_link"/>

    <origin xyz="0 0 ${-shin_length}" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-0.70"
      upper="0.70"
      effort="80"
      velocity="2.5"/>

  </joint>
    <!-- ===================================================== -->
  <!-- TAIL : 2 DOF                                         -->
  <!-- Tail Yaw + Tail Pitch                                 -->
  <!-- ===================================================== -->


  <!-- 9. TAIL YAW LINK -->
  <!-- 몸통 뒤쪽에서 좌우로 회전하는 꼬리 베이스 -->

  <link name="tail_yaw_link">

    <xacro:unless value="$(arg detailed_visuals)"><visual>
      <!-- 관절 기준 뒤쪽(-X)으로 꼬리 베이스가 뻗음 -->
      <origin xyz="-0.08 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.16 0.09 0.09"/>
      </geometry>

      <material name="tail_dark">
        <color rgba="0.18 0.19 0.21 1.0"/>
      </material>
    </visual></xacro:unless>
    <xacro:if value="$(arg detailed_visuals)">
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/tail_yaw_link__graphite.dae"/></geometry><material name="raptor_graphite"><color rgba="0.065 0.075 0.085 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/tail_yaw_link__titanium.dae"/></geometry><material name="raptor_titanium"><color rgba="0.36 0.4 0.43 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/tail_yaw_link__ivory.dae"/></geometry><material name="raptor_ivory"><color rgba="0.72 0.72 0.65 1"/></material></visual>
    </xacro:if>

    <collision>
      <origin xyz="-0.08 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.16 0.09 0.09"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.08 0 0" rpy="0 0 0"/>

      <mass value="0.5"/>

      <inertia
        ixx="0.0007"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0014"
        iyz="0.0"
        izz="0.0014"/>
    </inertial>

  </link>


  <joint name="tail_yaw_joint" type="revolute">

    <parent link="base_link"/>
    <child link="tail_yaw_link"/>

    <!-- 몸통 뒤쪽 끝에 꼬리 장착 -->
    <origin xyz="-0.30 0 0" rpy="0 0 0"/>

    <!-- Z축 회전 = 좌우 움직임 -->
    <axis xyz="0 0 1"/>

    <!-- 약 좌우 ±46도 -->
    <limit
      lower="-0.80"
      upper="0.80"
      effort="50"
      velocity="2.0"/>

  </joint>


  <!-- 10. TAIL PITCH + MAIN TAIL -->
  <!-- 꼬리를 위아래로 움직이는 관절 -->

  <link name="tail_link">

    <xacro:unless value="$(arg detailed_visuals)"><visual>
      <!-- Pitch 관절에서 뒤쪽으로 0.5m 뻗는 꼬리 -->
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.50 0.075 0.075"/>
      </geometry>

      <material name="tail_gray">
        <color rgba="0.35 0.37 0.40 1.0"/>
      </material>
    </visual></xacro:unless>
    <xacro:if value="$(arg detailed_visuals)">
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/tail_link__graphite.dae"/></geometry><material name="raptor_graphite"><color rgba="0.065 0.075 0.085 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/tail_link__titanium.dae"/></geometry><material name="raptor_titanium"><color rgba="0.36 0.4 0.43 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/tail_link__ivory.dae"/></geometry><material name="raptor_ivory"><color rgba="0.72 0.72 0.65 1"/></material></visual>
      <visual><geometry><mesh filename="package://raptor_description/meshes/raptor/tail_link__copper.dae"/></geometry><material name="raptor_copper"><color rgba="0.66 0.29 0.08 1"/></material></visual>
    </xacro:if>

    <collision>
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.50 0.075 0.075"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>

      <mass value="0.8"/>

      <inertia
        ixx="0.0008"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0169"
        iyz="0.0"
        izz="0.0169"/>
    </inertial>

  </link>


  <joint name="tail_pitch_joint" type="revolute">

    <parent link="tail_yaw_link"/>
    <child link="tail_link"/>

    <!-- 꼬리 베이스 끝 -->
    <origin xyz="-0.16 0 0" rpy="0 0 0"/>

    <!-- Y축 회전 = 위 / 아래 -->
    <axis xyz="0 1 0"/>

    <!-- 약 ±34도 -->
    <limit
      lower="-0.60"
      upper="0.60"
      effort="50"
      velocity="2.0"/>

  </joint>
    <!-- ===================================================== -->
  <!-- ROS 2 CONTROL : 10 DOF                                -->
  <!-- ===================================================== -->

  <ros2_control name="GazeboSimSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>


    <!-- LEFT LEG -->

    <joint name="left_hip_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="left_hip_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"><xacro:if value="$(arg crouched_start)"><param name="initial_value">${crouch_hip}</param></xacro:if></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="left_knee_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"><xacro:if value="$(arg crouched_start)"><param name="initial_value">${crouch_knee}</param></xacro:if></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="left_ankle_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"><xacro:if value="$(arg crouched_start)"><param name="initial_value">${-crouch_knee-crouch_hip}</param></xacro:if></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>


    <!-- RIGHT LEG -->

    <joint name="right_hip_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="right_hip_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"><xacro:if value="$(arg crouched_start)"><param name="initial_value">${crouch_hip}</param></xacro:if></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="right_knee_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"><xacro:if value="$(arg crouched_start)"><param name="initial_value">${crouch_knee}</param></xacro:if></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="right_ankle_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"><xacro:if value="$(arg crouched_start)"><param name="initial_value">${-crouch_knee-crouch_hip}</param></xacro:if></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>


    <!-- TAIL -->

    <joint name="tail_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="tail_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

  </ros2_control>


  <!-- Gazebo ↔ ros2_control bridge -->

  <gazebo>

    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>
        $(find raptor_control)/config/controllers.yaml
      </parameters>

      <!-- controller가 아직 안 잡은 관절도 현재 위치 유지 -->
      <hold_joints>true</hold_joints>

      <!-- position control 반응 강도 -->
      <position_proportional_gain>0.3</position_proportional_gain>

    </plugin>

  </gazebo>

  <xacro:if value="$(arg passive_toes)">
    <gazebo><plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/raptor/passive_joint_states</topic><update_rate>50</update_rate>
      <joint_name>left_toe_1_proximal_joint</joint_name>
      <joint_name>left_toe_1_distal_joint</joint_name>
      <joint_name>left_toe_2_proximal_joint</joint_name>
      <joint_name>left_toe_2_distal_joint</joint_name>
      <joint_name>left_toe_3_proximal_joint</joint_name>
      <joint_name>left_toe_3_distal_joint</joint_name>
      <joint_name>right_toe_1_proximal_joint</joint_name>
      <joint_name>right_toe_1_distal_joint</joint_name>
      <joint_name>right_toe_2_proximal_joint</joint_name>
      <joint_name>right_toe_2_distal_joint</joint_name>
      <joint_name>right_toe_3_proximal_joint</joint_name>
      <joint_name>right_toe_3_distal_joint</joint_name>
    </plugin></gazebo>
  </xacro:if>
</robot>
