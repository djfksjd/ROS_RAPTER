<?xml version="1.0"?>

<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="raptor">

    <!-- Dummy root link for KDL -->
  <link name="base_root"/>

  <joint name="base_root_joint" type="fixed">
    <parent link="base_root"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!--
    Raptor prototype
    Step 1: body only
  -->

  <link name="base_link">

    <!-- 화면에 보이는 외형 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.60 0.28 0.22"/>
      </geometry>

      <material name="body_gray">
        <color rgba="0.35 0.37 0.40 1.0"/>
      </material>
    </visual>

    <!-- Gazebo가 충돌 계산할 때 사용하는 모양 -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.60 0.28 0.22"/>
      </geometry>
    </collision>

    <!-- 무게와 회전 특성 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="8.0"/>

      <inertia
        ixx="0.0843"
        ixy="0.0"
        ixz="0.0"
        iyy="0.2691"
        iyz="0.0"
        izz="0.2923"/>
    </inertial>

    </link>
    <!-- ========================================= -->
    <!-- LEFT HIP ROLL -->
    <!-- 다리를 좌우로 벌리고 모으는 첫 번째 관절 -->
    <!-- ========================================= -->

    <link name="left_hip_roll_link">

    <visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>

      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>

      <material name="joint_dark">
        <color rgba="0.15 0.16 0.18 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>

      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>

      <mass value="0.8"/>

      <inertia
        ixx="0.0016"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0016"
        iyz="0.0"
        izz="0.0013"/>
    </inertial>

  </link>


  <joint name="left_hip_roll_joint" type="revolute">

    <parent link="base_link"/>
    <child link="left_hip_roll_link"/>

    <!-- 몸통 왼쪽 아래에 관절 배치 -->
    <origin xyz="0 0.18 -0.05" rpy="0 0 0"/>

    <!-- X축 회전 = Hip Roll -->
    <axis xyz="1 0 0"/>

    <!-- 약 -29도 ~ +29도 -->
    <limit
      lower="-0.50"
      upper="0.50"
      effort="80"
      velocity="2.0"/>

  </joint> 
    <!-- ========================================= -->
  <!-- LEFT HIP PITCH + THIGH -->
  <!-- 다리를 앞뒤로 움직이는 두 번째 관절 -->
  <!-- ========================================= -->

  <link name="left_thigh_link">

    <visual>
      <!-- 관절에서 아래쪽으로 허벅지가 내려감 -->
      <origin xyz="0 0 -0.16" rpy="0 0 0"/>

      <geometry>
        <box size="0.10 0.10 0.32"/>
      </geometry>

      <material name="leg_gray">
        <color rgba="0.55 0.57 0.60 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.16" rpy="0 0 0"/>

      <geometry>
        <box size="0.10 0.10 0.32"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.16" rpy="0 0 0"/>

      <mass value="1.5"/>

      <inertia
        ixx="0.0140"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0140"
        iyz="0.0"
        izz="0.0025"/>
    </inertial>

  </link>


  <joint name="left_hip_pitch_joint" type="revolute">

    <parent link="left_hip_roll_link"/>
    <child link="left_thigh_link"/>

    <!-- Hip Roll 블록 아래쪽에 Hip Pitch 배치 -->
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>

    <!-- Y축 회전 = 다리 앞뒤 움직임 -->
    <axis xyz="0 1 0"/>

    <!-- 약 -69도 ~ +46도 -->
    <limit
      lower="-1.20"
      upper="0.80"
      effort="100"
      velocity="2.5"/>

  </joint>
    <!-- ========================================= -->
  <!-- LEFT KNEE PITCH + SHIN -->
  <!-- 무릎을 굽히고 펴는 세 번째 관절 -->
  <!-- ========================================= -->

  <link name="left_shin_link">

    <visual>
      <!-- 무릎 아래로 종아리가 내려감 -->
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>

      <geometry>
        <box size="0.085 0.085 0.30"/>
      </geometry>

      <material name="shin_gray">
        <color rgba="0.42 0.44 0.47 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>

      <geometry>
        <box size="0.085 0.085 0.30"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>

      <mass value="1.1"/>

      <inertia
        ixx="0.0089"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0089"
        iyz="0.0"
        izz="0.0013"/>
    </inertial>

  </link>


  <joint name="left_knee_pitch_joint" type="revolute">

    <parent link="left_thigh_link"/>
    <child link="left_shin_link"/>

    <!-- 허벅지 끝 = 무릎 위치 -->
    <origin xyz="0 0 -0.32" rpy="0 0 0"/>

    <!-- Y축 회전 = 무릎 굽힘 -->
    <axis xyz="0 1 0"/>

    <!--
      0 rad = 다리를 편 상태
      약 126도까지 굽힘 허용
    -->
    <limit
      lower="0.0"
      upper="2.20"
      effort="120"
      velocity="3.0"/>

  </joint>
    <!-- ========================================= -->
  <!-- LEFT ANKLE PITCH + FOOT -->
  <!-- 발목을 앞뒤로 움직이는 네 번째 관절 -->
  <!-- ========================================= -->

  <link name="left_foot_link">

    <visual>
      <!-- 발목 기준으로 발을 약간 앞으로 배치 -->
      <origin xyz="0.06 0 -0.03" rpy="0 0 0"/>

      <geometry>
        <box size="0.24 0.12 0.06"/>
      </geometry>

      <material name="foot_dark">
        <color rgba="0.12 0.13 0.15 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.06 0 -0.03" rpy="0 0 0"/>

      <geometry>
        <box size="0.24 0.12 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.06 0 -0.03" rpy="0 0 0"/>

      <mass value="0.6"/>

      <inertia
        ixx="0.0009"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0031"
        iyz="0.0"
        izz="0.0036"/>
    </inertial>

  </link>


  <joint name="left_ankle_pitch_joint" type="revolute">

    <parent link="left_shin_link"/>
    <child link="left_foot_link"/>

    <!-- 종아리 끝부분에 발목 배치 -->
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>

    <!-- Y축 회전 = 발 앞뒤 기울임 -->
    <axis xyz="0 1 0"/>

    <!-- 약 -40도 ~ +40도 -->
    <limit
      lower="-0.70"
      upper="0.70"
      effort="80"
      velocity="2.5"/>

  </joint>
</robot>
