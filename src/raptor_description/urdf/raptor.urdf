        <box size="0.10 0.10 0.32"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.16"/>
      <mass value="1.5"/>
      <inertia ixx="0.0140" ixy="0.0" ixz="0.0" iyy="0.0140" iyz="0.0" izz="0.0025"/>
    </inertial>
  </link>
  <joint name="right_hip_pitch_joint" type="revolute">
    <parent link="right_hip_roll_link"/>
    <child link="right_thigh_link"/>
    <origin rpy="0 0 0" xyz="0 0 -0.12"/>
    <!-- 앞 / 뒤 -->
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-1.20" upper="0.80" velocity="2.5"/>
  </joint>
  <!-- 3. RIGHT KNEE PITCH + SHIN -->
  <link name="right_shin_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.085 0.085 0.30"/>
      </geometry>
      <material name="right_shin_gray">
        <color rgba="0.42 0.44 0.47 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.085 0.085 0.30"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.15"/>
      <mass value="1.1"/>
      <inertia ixx="0.0089" ixy="0.0" ixz="0.0" iyy="0.0089" iyz="0.0" izz="0.0013"/>
    </inertial>
  </link>
  <joint name="right_knee_pitch_joint" type="revolute">
    <parent link="right_thigh_link"/>
    <child link="right_shin_link"/>
    <origin rpy="0 0 0" xyz="0 0 -0.32"/>
    <axis xyz="0 1 0"/>
    <limit effort="120" lower="0.0" upper="2.20" velocity="3.0"/>
  </joint>
  <!-- 4. RIGHT ANKLE PITCH + FOOT -->
  <link name="right_foot_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.06 0 -0.03"/>
      <geometry>
        <box size="0.24 0.12 0.06"/>
      </geometry>
      <material name="right_foot_dark">
        <color rgba="0.12 0.13 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.06 0 -0.03"/>
      <geometry>
        <box size="0.24 0.12 0.06"/>
