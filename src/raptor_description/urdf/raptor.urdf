      <inertia ixx="0.0007" ixy="0.0" ixz="0.0" iyy="0.0014" iyz="0.0" izz="0.0014"/>
    </inertial>
  </link>
  <joint name="tail_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="tail_yaw_link"/>
    <!-- 몸통 뒤쪽 끝에 꼬리 장착 -->
    <origin rpy="0 0 0" xyz="-0.30 0 0"/>
    <!-- Z축 회전 = 좌우 움직임 -->
    <axis xyz="0 0 1"/>
    <!-- 약 좌우 ±46도 -->
    <limit effort="50" lower="-0.80" upper="0.80" velocity="2.0"/>
  </joint>
  <!-- 10. TAIL PITCH + MAIN TAIL -->
  <!-- 꼬리를 위아래로 움직이는 관절 -->
  <link name="tail_link">
    <visual>
      <!-- Pitch 관절에서 뒤쪽으로 0.5m 뻗는 꼬리 -->
      <origin rpy="0 0 0" xyz="-0.25 0 0"/>
      <geometry>
        <box size="0.50 0.075 0.075"/>
      </geometry>
      <material name="tail_gray">
        <color rgba="0.35 0.37 0.40 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.25 0 0"/>
