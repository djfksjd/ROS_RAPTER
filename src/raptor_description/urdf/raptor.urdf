  </link>
  <joint name="left_ankle_pitch_joint" type="revolute">
    <parent link="left_shin_link"/>
    <child link="left_foot_link"/>
    <!-- 종아리 끝부분에 발목 배치 -->
    <origin rpy="0 0 0" xyz="0 0 -0.30"/>
    <!-- Y축 회전 = 발 앞뒤 기울임 -->
    <axis xyz="0 1 0"/>
    <!-- 약 -40도 ~ +40도 -->
    <limit effort="80" lower="-0.70" upper="0.70" velocity="2.5"/>
  </joint>
  <!-- ===================================================== -->
  <!-- RIGHT LEG : 4 DOF                                     -->
  <!-- Hip Roll + Hip Pitch + Knee Pitch + Ankle Pitch       -->
  <!-- ===================================================== -->
  <!-- 1. RIGHT HIP ROLL LINK -->
  <link name="right_hip_roll_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.06"/>
      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>
      <material name="right_joint_dark">
        <color rgba="0.15 0.16 0.18 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.06"/>
      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.06"/>
      <mass value="0.8"/>
      <inertia ixx="0.0016" ixy="0.0" ixz="0.0" iyy="0.0016" iyz="0.0" izz="0.0013"/>
    </inertial>
  </link>
  <joint name="right_hip_roll_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_hip_roll_link"/>
    <!-- 오른쪽은 Y 음수 방향 -->
    <origin rpy="0 0 0" xyz="0 -0.18 -0.05"/>
    <!--
      오른쪽은 왼쪽과 반대 방향의 X축을 사용.
      따라서 양쪽에서 +값을 줬을 때 다리가 바깥으로 벌어지게 함.
    -->
    <axis xyz="-1 0 0"/>
    <limit effort="80" lower="-0.50" upper="0.50" velocity="2.0"/>
  </joint>
  <!-- 2. RIGHT HIP PITCH + THIGH -->
  <link name="right_thigh_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.16"/>
      <geometry>
        <box size="0.10 0.10 0.32"/>
      </geometry>
      <material name="right_leg_gray">
        <color rgba="0.55 0.57 0.60 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.16"/>
