      <inertia ixx="0.0009" ixy="0.0" ixz="0.0" iyy="0.0031" iyz="0.0" izz="0.0036"/>
    </inertial>
  </link>
  <joint name="right_ankle_pitch_joint" type="revolute">
    <parent link="right_shin_link"/>
    <child link="right_foot_link"/>
    <origin rpy="0 0 0" xyz="0 0 -0.30"/>
    <axis xyz="0 1 0"/>
    <limit effort="80" lower="-0.70" upper="0.70" velocity="2.5"/>
  </joint>
  <!-- ===================================================== -->
  <!-- TAIL : 2 DOF                                         -->
  <!-- Tail Yaw + Tail Pitch                                 -->
  <!-- ===================================================== -->
  <!-- 9. TAIL YAW LINK -->
  <!-- 몸통 뒤쪽에서 좌우로 회전하는 꼬리 베이스 -->
  <link name="tail_yaw_link">
    <visual>
      <!-- 관절 기준 뒤쪽(-X)으로 꼬리 베이스가 뻗음 -->
      <origin rpy="0 0 0" xyz="-0.08 0 0"/>
      <geometry>
        <box size="0.16 0.09 0.09"/>
      </geometry>
      <material name="tail_dark">
        <color rgba="0.18 0.19 0.21 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.08 0 0"/>
      <geometry>
        <box size="0.16 0.09 0.09"/>
      </geometry>
