    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.15"/>
      <mass value="1.1"/>
      <inertia ixx="0.0089" ixy="0.0" ixz="0.0" iyy="0.0089" iyz="0.0" izz="0.0013"/>
    </inertial>
  </link>
  <joint name="left_knee_pitch_joint" type="revolute">
    <parent link="left_thigh_link"/>
    <child link="left_shin_link"/>
    <!-- 허벅지 끝 = 무릎 위치 -->
    <origin rpy="0 0 0" xyz="0 0 -0.32"/>
    <!-- Y축 회전 = 무릎 굽힘 -->
    <axis xyz="0 1 0"/>
    <!--
      0 rad = 다리를 편 상태
      약 126도까지 굽힘 허용
    -->
    <limit effort="120" lower="0.0" upper="2.20" velocity="3.0"/>
  </joint>
  <!-- ========================================= -->
  <!-- LEFT ANKLE PITCH + FOOT -->
  <!-- 발목을 앞뒤로 움직이는 네 번째 관절 -->
  <!-- ========================================= -->
  <link name="left_foot_link">
    <visual>
      <!-- 발목 기준으로 발을 약간 앞으로 배치 -->
      <origin rpy="0 0 0" xyz="0.06 0 -0.03"/>
      <geometry>
        <box size="0.24 0.12 0.06"/>
      </geometry>
      <material name="foot_dark">
        <color rgba="0.12 0.13 0.15 1.0"/>
