        <box size="0.60 0.28 0.22"/>
      </geometry>
    </collision>
    <!-- 무게와 회전 특성 -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.0843" ixy="0.0" ixz="0.0" iyy="0.2691" iyz="0.0" izz="0.2923"/>
    </inertial>
  </link>
  <!-- ========================================= -->
  <!-- LEFT HIP ROLL -->
  <!-- 다리를 좌우로 벌리고 모으는 첫 번째 관절 -->
  <!-- ========================================= -->
  <link name="left_hip_roll_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.06"/>
      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>
      <material name="joint_dark">
        <color rgba="0.15 0.16 0.18 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.06"/>
      <geometry>
        <box size="0.12 0.10 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.06"/>
      <mass value="0.8"/>
      <inertia ixx="0.0016" ixy="0.0" ixz="0.0" iyy="0.0016" iyz="0.0" izz="0.0013"/>
    </inertial>
  </link>
  <joint name="left_hip_roll_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_hip_roll_link"/>
    <!-- 몸통 왼쪽 아래에 관절 배치 -->
    <origin rpy="0 0 0" xyz="0 0.18 -0.05"/>
    <!-- X축 회전 = Hip Roll -->
    <axis xyz="1 0 0"/>
    <!-- 약 -29도 ~ +29도 -->
    <limit effort="80" lower="-0.50" upper="0.50" velocity="2.0"/>
  </joint>
  <!-- ========================================= -->
  <!-- LEFT HIP PITCH + THIGH -->
  <!-- 다리를 앞뒤로 움직이는 두 번째 관절 -->
  <!-- ========================================= -->
  <link name="left_thigh_link">
    <visual>
      <!-- 관절에서 아래쪽으로 허벅지가 내려감 -->
      <origin rpy="0 0 0" xyz="0 0 -0.16"/>
      <geometry>
        <box size="0.10 0.10 0.32"/>
      </geometry>
      <material name="leg_gray">
        <color rgba="0.55 0.57 0.60 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.16"/>
      <geometry>
        <box size="0.10 0.10 0.32"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.16"/>
      <mass value="1.5"/>
      <inertia ixx="0.0140" ixy="0.0" ixz="0.0" iyy="0.0140" iyz="0.0" izz="0.0025"/>
    </inertial>
  </link>
  <joint name="left_hip_pitch_joint" type="revolute">
    <parent link="left_hip_roll_link"/>
    <child link="left_thigh_link"/>
    <!-- Hip Roll 블록 아래쪽에 Hip Pitch 배치 -->
    <origin rpy="0 0 0" xyz="0 0 -0.12"/>
    <!-- Y축 회전 = 다리 앞뒤 움직임 -->
    <axis xyz="0 1 0"/>
    <!-- 약 -69도 ~ +46도 -->
    <limit effort="100" lower="-1.20" upper="0.80" velocity="2.5"/>
  </joint>
  <!-- ========================================= -->
  <!-- LEFT KNEE PITCH + SHIN -->
  <!-- 무릎을 굽히고 펴는 세 번째 관절 -->
  <!-- ========================================= -->
  <link name="left_shin_link">
    <visual>
      <!-- 무릎 아래로 종아리가 내려감 -->
      <origin rpy="0 0 0" xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.085 0.085 0.30"/>
      </geometry>
      <material name="shin_gray">
        <color rgba="0.42 0.44 0.47 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.085 0.085 0.30"/>
