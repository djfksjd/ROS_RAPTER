<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Experimental robot foot, not an anatomical reconstruction or rated hardware. -->
  <xacro:macro name="toe_segment" params="side digit part parent xyz yaw length stiffness distal:=false">
    <xacro:property name="link_name" value="${side}_toe_${digit}_${part}_link"/>
    <xacro:property name="joint_name" value="${side}_toe_${digit}_${part}_joint"/>
    <link name="${link_name}">
      <visual><origin xyz="${length/2} 0 0"/>
        <geometry><box size="${length} 0.026 0.034"/></geometry>
        <material name="toe_armor"><color rgba="0.65 0.66 0.60 1"/></material></visual>
      <visual><origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="0.020" length="0.033"/></geometry>
        <material name="toe_hinge"><color rgba="0.20 0.23 0.25 1"/></material></visual>
      <visual><origin xyz="${length/2} 0 -0.014"/>
        <geometry><box size="${length*0.9} 0.027 0.008"/></geometry>
        <material name="toe_pad"><color rgba="0.035 0.035 0.04 1"/></material></visual>
      <xacro:if value="${distal}">
        <!-- Claw is visual only; sharp terrain anchoring is not simulated. -->
        <visual><origin xyz="${length+0.010} 0 -0.004" rpy="0 0.3 0"/>
          <geometry><box size="0.026 0.012 0.013"/></geometry>
          <material name="toe_claw"><color rgba="0.12 0.14 0.16 1"/></material></visual>
      </xacro:if>
      <collision><origin xyz="${length/2} 0 0"/>
        <geometry><box size="${length} 0.026 0.034"/></geometry></collision>
      <inertial><origin xyz="${length/2} 0 0"/><mass value="0.05"/>
        <inertia ixx="${0.05*(0.026**2+0.034**2)/12}" ixy="0" ixz="0"
                 iyy="${0.05*(length**2+0.034**2)/12}" iyz="0"
                 izz="${0.05*(length**2+0.026**2)/12}"/></inertial>
    </link>
    <joint name="${joint_name}" type="revolute">
      <parent link="${parent}"/><child link="${link_name}"/>
      <origin xyz="${xyz}" rpy="0 0 ${yaw}"/><axis xyz="0 1 0"/>
      <limit lower="-0.55" upper="0.65" effort="5" velocity="4"/>
      <dynamics damping="0.08" friction="0.005"/>
    </joint>
    <gazebo reference="${joint_name}">
      <springReference>0</springReference><springStiffness>${stiffness}</springStiffness>
    </gazebo>
    <gazebo reference="${link_name}">
      <mu1>0.8</mu1><mu2>0.8</mu2>
      <xacro:if value="$(arg sensors)">
        <sensor name="${side}_toe_${digit}_${part}_contact" type="contact">
          <always_on>true</always_on><update_rate>50</update_rate>
          <contact><collision>${link_name}_collision</collision>
            <topic>/raptor/${side}/toe_${digit}_${part}/contact</topic></contact>
        </sensor>
      </xacro:if>
    </gazebo>
  </xacro:macro>
  <xacro:macro name="toe_digit" params="side digit y yaw">
    <xacro:toe_segment side="${side}" digit="${digit}" part="proximal"
      parent="${side}_foot_link" xyz="0.005 ${y} -0.043" yaw="${yaw}"
      length="0.070" stiffness="12"/>
    <xacro:toe_segment side="${side}" digit="${digit}" part="distal"
      parent="${side}_toe_${digit}_proximal_link" xyz="0.070 0 0" yaw="0"
      length="0.075" stiffness="8" distal="true"/>
  </xacro:macro>
  <xacro:macro name="passive_foot" params="side">
    <link name="${side}_foot_link">
      <visual><origin xyz="-0.015 0 -0.03"/>
        <geometry><box size="0.09 0.10 0.06"/></geometry>
        <material name="heel_pad"><color rgba="0.08 0.09 0.10 1"/></material></visual>
      <visual><origin rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="0.037" length="0.10"/></geometry>
        <material name="ankle_housing"><color rgba="0.36 0.40 0.43 1"/></material></visual>
      <collision><origin xyz="-0.015 0 -0.03"/>
        <geometry><box size="0.09 0.10 0.06"/></geometry></collision>
      <inertial><origin xyz="-0.015 0 -0.03"/><mass value="0.30"/>
        <inertia ixx="0.00034" ixy="0" ixz="0" iyy="0.0002925" iyz="0" izz="0.0004525"/>
      </inertial>
    </link>
    <xacro:toe_digit side="${side}" digit="1" y="0.040" yaw="0.12"/>
    <xacro:toe_digit side="${side}" digit="2" y="0" yaw="0"/>
    <xacro:toe_digit side="${side}" digit="3" y="-0.040" yaw="-0.12"/>
  </xacro:macro>
</robot>
