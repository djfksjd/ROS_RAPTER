<?xml version="1.0" ?>

<sdf version="1.9">

  <world name="raptor_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 중력 -->
    <gravity>0 0 -9.81</gravity>

    <!-- 물리 엔진 -->
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 빛 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>

      <pose>
        0 0 10 0 0 0
      </pose>

      <diffuse>
        0.8 0.8 0.8 1
      </diffuse>

      <specular>
        0.2 0.2 0.2 1
      </specular>

      <direction>
        -0.5 0.1 -0.9
      </direction>
    </light>

    <!-- 바닥 -->
    <model name="ground_plane">

      <static>true</static>

      <link name="link">

        <collision name="collision">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- Static contact-conformity test, not a validated traversable terrain. -->
    <model name="toe_contact_step"><static>true</static><pose>0.12 0.233 0.004 0 0 0</pose>
      <link name="step">
        <collision name="collision"><geometry><box><size>0.07 0.032 0.008</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.07 0.032 0.008</size></box></geometry>
          <material><ambient>0.7 0.25 0.08 1</ambient><diffuse>0.7 0.25 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>

</sdf>
